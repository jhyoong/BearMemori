TELEGRAM_BOT_TOKEN=your-token-here
TELEGRAM_ALLOWED_USER_ID=your-telegram-user-id

# LLM settings
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3
LLM_API_KEY=not-needed

# Embedding model (used for vector search)
EMBEDDING_MODEL=all-mpnet-base-v2

# SQLite database path
DATABASE_PATH=bearmemori.db

# ChromaDB vector store persistence directory
CHROMA_PERSIST_DIR=chroma_data

# How long (in seconds) a pending memory entry is kept before expiry (default 30 minutes)
PENDING_TTL_SECONDS=1800

# Internal event queue size
QUEUE_MAX_SIZE=1000

# Hours before a follow-up is considered timed out
FOLLOWUP_TIMEOUT_HOURS=24

# How often (in seconds) the reminder scheduler polls for due reminders
REMINDER_POLL_INTERVAL_SECONDS=60

# Number of top results to return from vector retrieval
RETRIEVAL_TOP_K=5

# Number of days ahead to look for upcoming events
UPCOMING_EVENTS_DAYS=7

# Port for the internal HTTP API
API_PORT=8100

# Webapp secret for authentication (empty disables webapp)
WEBAPP_SECRET=

# Memory reflection settings
# Hour of day (local time) to start the reflection window (default 2am)
REFLECTION_START_HOUR=2
# Hour of day (local time) to end the reflection window (default 6am)
REFLECTION_END_HOUR=6
# How often (in seconds) the reflection scheduler polls within the window
REFLECTION_POLL_INTERVAL_SECONDS=3600
# Minimum age (days) for low-importance (1-2) memories to be considered for reflection
REFLECTION_LOW_IMPORTANCE_AGE_DAYS=30
# Minimum age (days) for needs-review memories to be considered for reflection
REFLECTION_NEEDS_REVIEW_AGE_DAYS=21
# Minimum age (days) for mid-importance (3-7) memories to be considered for reflection
REFLECTION_MID_IMPORTANCE_AGE_DAYS=90
# Path to the JSONL file where reflection run summaries are logged
REFLECTION_LOG_PATH=data/reflection.log
REFLECTION_DUPLICATE_SIMILARITY_THRESHOLD=0.85
REFLECTION_DUPLICATE_TOP_K=5
REFLECTION_REJECT_COOLDOWN_DAYS=30
REFLECTION_STATE_PATH=data/reflection_state.json
